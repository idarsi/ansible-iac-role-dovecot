# The role vendors tasks/shared as an external git submodule. Its lint findings
# belong to ansible-iac-shared-tasks, so only that submodule is excluded here.
# The role, examples, and Molecule scenarios remain in the production check.
exclude_paths:
  - "tasks/shared/"
  # The bundled metadata schema predates Rocky/RHEL 9 and 10. Keep accurate
  # platform versions in meta/main.yml rather than claiming support for all.
  - "meta/main.yml"
