# Managed by Ansible. Manual changes may be overwritten.
{% set dovecot_template_version = dovecot_render_version | default(dovecot_version.stdout | default('2.3.0'), true) %}

protocols = {{ dovecot_configuration.protocols | default(dovecot_default_protocols) | join(' ') }}
mail_location = {{ dovecot_configuration.mail_location | default(dovecot_default_mail_location) }}

{% if dovecot_template_version is version('2.4.0', '>=') %}
auth_allow_cleartext = {{ 'no' if dovecot_configuration.disable_plaintext_auth | default(dovecot_default_disable_plaintext_auth) else 'yes' }}
{% else %}
disable_plaintext_auth = {{ 'yes' if dovecot_configuration.disable_plaintext_auth | default(dovecot_default_disable_plaintext_auth) else 'no' }}
{% endif %}
auth_mechanisms = {{ dovecot_configuration.auth_mechanisms | default(dovecot_default_auth_mechanisms) | join(' ') }}

{% if dovecot_configuration.ssl_cert is defined and dovecot_configuration.ssl_key is defined %}
ssl = {{ dovecot_configuration.ssl | default(dovecot_default_ssl) }}
ssl_cert = <{{ dovecot_configuration.ssl_cert }}
ssl_key = <{{ dovecot_configuration.ssl_key }}
{% else %}
ssl = {{ dovecot_configuration.ssl | default('no') }}
{% endif %}

{% for key, value in dovecot_configuration.extra_parameters | default({}) | dictsort %}
{{ key }} = {{ value }}
{% endfor %}
